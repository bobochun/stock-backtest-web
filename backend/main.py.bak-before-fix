def _data_status_check_result(
    key: str,
    title: str,
    status: str,
    message: str,
    detail=None,
    latency_ms: int = 0,
):
    return {
        "key": key,
        "title": title,
        "status": status,
        "message": message,
        "detail": detail or {},
        "latencyMs": latency_ms,
    }


def _data_status_run_check(key: str, title: str, fn):
    start = _data_status_time.time()

    try:
        detail = fn()
        latency_ms = int((_data_status_time.time() - start) * 1000)

        return _data_status_check_result(
            key=key,
            title=title,
            status=detail.get("status", "ok"),
            message=detail.get("message", "正常"),
            detail=detail,
            latency_ms=latency_ms,
        )
    except Exception as error:
        latency_ms = int((_data_status_time.time() - start) * 1000)

        return _data_status_check_result(
            key=key,
            title=title,
            status="error",
            message=str(error),
            detail={"error": str(error)},
            latency_ms=latency_ms,
        )


@app.get("/data-status")
def read_data_status():
    today = _DataStatusDate.today()
    end_date = (today + _DataStatusTimedelta(days=1)).isoformat()
    start_date = (today - _DataStatusTimedelta(days=45)).isoformat()
    today_text = today.strftime("%Y%m%d")

    def check_backend():
        return {
            "status": "ok",
            "message": "FastAPI 後端正常運作",
            "generatedAt": _DataStatusDateTime.now().isoformat(timespec="seconds"),
        }

    def check_price_data():
        price_data, ticker_used = fetch_real_price_series(
            "2330",
            start_date,
            end_date,
        )

        if not price_data:
            return {
                "status": "error",
                "message": "Yahoo Finance 沒有回傳價格資料",
            }

        latest = price_data[-1]

        return {
            "status": "ok",
            "message": "Yahoo Finance 價格資料可用",
            "symbol": "2330",
            "tickerUsed": ticker_used,
            "lastDate": latest.get("date"),
            "lastClose": latest.get("close"),
            "rows": len(price_data),
        }

    def check_security_master():
        info = get_security_info("2330")

        name = info.get("name", "")

        if not name or name == "未找到名稱":
            return {
                "status": "warn",
                "message": "security master 可查詢，但股票名稱可能不完整",
                "info": info,
            }

        return {
            "status": "ok",
            "message": "台股名稱資料可用",
            "info": info,
        }

    def check_twse_latest_flow():
        try:
            from institutional_flow import get_latest_available_daily_flow_map
        except Exception:
            from backend.institutional_flow import get_latest_available_daily_flow_map

        used_date, flow_map = get_latest_available_daily_flow_map(
            today_text,
            lookback_days=7,
            force_refresh=False,
        )

        record = flow_map.get("2330")

        if not record:
            return {
                "status": "warn",
                "message": f"TWSE T86 有資料日期 {used_date}，但未找到 2330",
                "usedDate": used_date,
                "recordCount": len(flow_map),
            }

        return {
            "status": "ok",
            "message": "TWSE T86 最新法人資料可用",
            "usedDate": used_date,
            "recordCount": len(flow_map),
            "sample": {
                "symbol": "2330",
                "foreignNetLots": record.get("foreignNetLots"),
                "trustNetLots": record.get("trustNetLots"),
                "dealerNetLots": record.get("dealerNetLots"),
                "score": record.get("score"),
                "signal": record.get("signal"),
            },
        }

    def check_finmind_flow():
        try:
            from institutional_flow import fetch_finmind_institutional_range
            from institutional_flow import parse_finmind_institutional_payload
        except Exception:
            from backend.institutional_flow import fetch_finmind_institutional_range
            from backend.institutional_flow import parse_finmind_institutional_payload

        payload = fetch_finmind_institutional_range(
            symbol="2330",
            start_date=(today - _DataStatusTimedelta(days=30)).strftime("%Y%m%d"),
            end_date=today_text,
            force_refresh=False,
        )

        parsed = parse_finmind_institutional_payload("2330", payload)
        dates = sorted(parsed.keys())

        if not dates:
            return {
                "status": "warn",
                "message": "FinMind API 可連線，但 2330 近期法人資料為空",
                "rawRows": len(payload.get("data", [])),
            }

        latest_date = dates[-1]
        latest_record = parsed[latest_date]

        return {
            "status": "ok",
            "message": "FinMind 法人區間資料可用",
            "rawRows": len(payload.get("data", [])),
            "parsedDays": len(dates),
            "latestDate": latest_date,
            "sample": {
                "foreignNetLots": latest_record.get("foreignNetLots"),
                "trustNetLots": latest_record.get("trustNetLots"),
                "dealerNetLots": latest_record.get("dealerNetLots"),
                "score": latest_record.get("score"),
                "signal": latest_record.get("signal"),
            },
        }

    def check_flow_cache():
        cache_candidates = []

        try:
            from institutional_flow import FLOW_CACHE_DIR
            cache_candidates.append(_DataStatusPath(FLOW_CACHE_DIR))
        except Exception:
            pass

        cache_candidates.extend(
            [
                _DataStatusPath("backend/.cache"),
                _DataStatusPath("backend/cache"),
                _DataStatusPath(".cache"),
            ]
        )

        existing_dirs = []
        total_files = 0
        total_bytes = 0

        for path in cache_candidates:
            if not path.exists() or not path.is_dir():
                continue

            files = [item for item in path.rglob("*") if item.is_file()]
            file_bytes = sum(item.stat().st_size for item in files)

            existing_dirs.append(str(path))
            total_files += len(files)
            total_bytes += file_bytes

        if not existing_dirs:
            return {
                "status": "warn",
                "message": "尚未找到法人快取資料夾，可能還沒建立快取",
                "directories": [],
                "files": 0,
                "sizeBytes": 0,
            }

        return {
            "status": "ok",
            "message": "法人資料快取可讀取",
            "directories": existing_dirs,
            "files": total_files,
            "sizeBytes": total_bytes,
        }

    checks = [
        _data_status_run_check("backend", "後端 API", check_backend),
        _data_status_run_check("price", "Yahoo 價格資料", check_price_data),
        _data_status_run_check("security", "台股名稱資料", check_security_master),
        _data_status_run_check("twse", "TWSE 最新法人資料", check_twse_latest_flow),
        _data_status_run_check("finmind", "FinMind 法人區間資料", check_finmind_flow),
        _data_status_run_check("cache", "法人資料快取", check_flow_cache),
    ]

    ok_count = len([item for item in checks if item["status"] == "ok"])
    warn_count = len([item for item in checks if item["status"] == "warn"])
    error_count = len([item for item in checks if item["status"] == "error"])

    overall_status = "ok"

    if error_count > 0:
        overall_status = "error"
    elif warn_count > 0:
        overall_status = "warn"

    return {
        "ok": error_count == 0,
        "overallStatus": overall_status,
        "generatedAt": _DataStatusDateTime.now().isoformat(timespec="seconds"),
        "summary": {
            "ok": ok_count,
            "warn": warn_count,
            "error": error_count,
            "total": len(checks),
        },
        "checks": checks,
    }
